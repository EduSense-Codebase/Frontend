{
  "name": "edusense-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,jsx,json,css,md}\"",
    "pre-commit": "prettier --write \"src/**/*.{js,ts,tsx,jsx,json,css,md}\"; next lint --max-warnings 0",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@mdxeditor/editor": "^3.40.1",
    "@opennextjs/cloudflare": "^1.6.5",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.8.4",
    "framer-motion": "^12.12.1",
    "install": "^0.13.0",
    "latex.js": "^0.12.6",
    "motion": "^12.12.2",
    "next": "15.3.0",
    "npm": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-joyride": "^3.0.0-7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mark": "^0.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@cloudflare/next-on-pages": "^1.13.13",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^9.1.1",
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/addon-vitest": "^9.1.1",
    "@storybook/nextjs-vite": "^9.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-storybook": "^9.1.1",
    "next": "15.3.0",
    "playwright": "^1.54.2",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "sass": "^1.92.0",
    "storybook": "^9.1.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
}
